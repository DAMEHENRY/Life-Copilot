{
  "manifest_version": 3,
  "name": "Life Copilot Web Chat Archiver",
  "version": "1.2.0",
  "description": "Archives Claude and ChatGPT web conversations into the local Life Copilot store.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Life Copilot: sync Claude / ChatGPT web chats"
  }
}
